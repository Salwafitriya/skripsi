",\n","    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:125.0) Gecko/20100101 Firefox/125.0\",\n","]\n","\n","# ── 3. HTTP Helper ───────────────────────────────────────────\n","def random_headers():\n","    return {\n","        \"User-Agent\": random.choice(USER_AGENTS),\n","        \"Accept-Language\": \"id-ID,id;q=0.9,en-US;q=0.8\",\n","        \"Referer\": \"https://www.google.com/\",\n","    }\n","\n","def polite_sleep(lo=0.8, hi=1.8):\n","    time.sleep(random.uniform(lo, hi))\n","\n","def safe_get(url):\n","    try:\n","        r = requests.get(url, headers=random_headers(), timeout=15)\n","        if r.status_code == 200:\n","            return BeautifulSoup(r.text, \"lxml\")\n","    except Exception as e:\n","        log.warning(f\"Request gagal: {url}\")\n","    return None\n","\n","\n","# ── 4. Cleaning Text ─────────────────────────────────────────\n","_NOISE = re.compile(\n","    r\"(Baca juga|Simak Video|Advertisement|Lihat Juga|Editor:|Reporter:)\",\n","    re.IGNORECASE\n",")\n","\n","def clean_text(text):\n","    text = _NOISE.sub(\" \", text)\n","    text = re.sub(r\"\\s+\", \" \", text)\n","    return text.strip()\n","\n","\n","# ── 5. Parsing Tanggal ───────────────────────────────────────\n","MONTHS = {\n","    \"januari\":1,\"februari\":2,\"maret\":3,\"april\":4,\"mei\":5,\"juni\":6,\n","    \"juli\":7,\"agustus\":8,\"september\":9,\"oktober\":10,\"november\":11,\"desember\":12\n","}\n","\n","def parse_date(raw):\n","    if not raw:\n","        return None\n","\n","    m = re.search(r\"(\\d{1,2})\\s+([A-Za-z]+)\\s+(\\d{4})\", raw)\n","    if m:\n","        d = int(m.group(1))\n","        mth = MONTHS.get(m.group(2).lower())\n","        y = int(m.group(3))\n","\n","        if mth:\n","            return f\"{y}-{mth:02d}-{d:02d}\"\n","\n","    return None\n","\n","\n","def in_range(date):\n","    if not date:\n","        return False\n","    return YEAR_START <= int(date[:4]) <= YEAR_END\n","\n","\n","# ── 6. Extract Full Article ──────────────────────────────────\n","def extract_body(url):\n","\n","    soup = safe_get(url)\n","    if not soup:\n","        return \"\"\n","\n","    body = soup.select_one(\n","        \"div.read__content, div.article__content, div.read-content\"\n","    )\n","\n","    if not body:\n","        return \"\"\n","\n","    paragraphs = []\n","\n","    for p in body.find_all(\"p\"):\n","\n","        text = p.get_text(strip=True)\n","\n","        if not text:\n","            continue\n","\n","        if re.search(\n","            r\"(baca juga|simak video|advertisement)\",\n","            text,\n","            re.IGNORECASE,\n","        ):\n","            continue\n","\n","        paragraphs.append(text)\n","\n","    return clean_text(\" \".join(paragraphs))\n","\n","\n","# ── 7. Build Search URL ──────────────────────────────────────\n","def build_search_url(keyword, page):\n","    return (\n","        f\"https://search.kompas.com/search/?q=\"\n","        f\"{requests.utils.quote(keyword)}&page={page}\"\n","    )\n","\n","\n","# ── 8. Scrape Keyword ────────────────────────────────────────\n","def scrape_keyword(keyword):\n","\n","    log.info(f\"Keyword: {keyword}\")\n","\n","    records = []\n","\n","    for page in range(1, MAX_PAGES + 1):\n","\n","        url = build_search_url(keyword, page)\n","\n","        log.info(f\"Halaman {page}\")\n","\n","        soup = safe_get(url)\n","\n","        if not soup:\n","            break\n","\n","        items = soup.select(\"div.article__list\")\n","\n","        if not items:\n","            break\n","\n","        added = 0\n","\n","        for item in items:\n","\n","            try:\n","\n","                title_tag = item.select_one(\n","                    \"h2.article__title a\"\n","                )\n","\n","                if not title_tag:\n","                    continue\n","\n","                title = title_tag.text.strip()\n","                link = title_tag[\"href\"]\n","\n","                date_tag = item.select_one(\n","                    \"div.article__date\"\n","                )\n","\n","                raw_date = (\n","                    date_tag.text.strip()\n","                    if date_tag else \"\"\n","                )\n","\n","                date = parse_date(raw_date)\n","\n","                if not in_range(date):\n","                    continue\n","\n","                polite_sleep()\n","\n","                content = extract_body(link)\n","\n","                if not content:\n","                    continue\n","\n","                records.append({\n","                    \"source\": \"Kompas.com\",\n","                    \"keyword\": keyword,\n","                    \"title\": title,\n","                    \"date\": date,\n","                    \"url\": link,\n","                    \"content\": content\n","                })\n","\n","                added += 1\n","\n","            except Exception as e:\n","                continue\n","\n","        log.info(f\"{added} artikel ditambahkan\")\n","\n","        polite_sleep(2,3)\n","\n","    return records\n","\n","\n","# ── 9. Main Run ──────────────────────────────────────────────\n","def run():\n","\n","    all_data = []\n","\n","    for kw in KEYWORDS:\n","\n","        try:\n","            data = scrape_keyword(kw)\n","            all_data.extend(data)\n","\n","        except Exception as e:\n","            log.warning(e)\n","\n","        polite_sleep(3,5)\n","\n","    if not all_data:\n","        log.warning(\"Tidak ada data\")\n","        return pd.DataFrame()\n","\n","    df = pd.DataFrame(all_data)\n","\n","    before = len(df)\n","\n","    df.drop_duplicates(\n","        subset=[\"url\"],\n","        inplace=True\n","    )\n","\n","    log.info(\n","        f\"Deduplikasi: {before} -> {len(df)}\"\n","    )\n","\n","    df = df[\n","        df[\"date\"].apply(in_range)\n","    ]\n","\n","    df = df[\n","        [\"source\",\"keyword\",\"title\",\"date\",\"url\",\"content\"]\n","    ]\n","\n","    df.sort_values(\n","        \"date\",\n","        ascending=False,\n","        inplace=True\n","    )\n","\n","    df.to_csv(\n","        OUTPUT_FILE,\n","        index=False,\n","        encoding=\"utf-8-sig\",\n","        quoting=csv.QUOTE_ALL\n","    )\n","\n","    log.info(f\"Saved: {OUTPUT_FILE}\")\n","\n","    return df\n","\n","\n","# ── 10. Entry ────────────────────────────────────────────────\n","if __name__ == \"__main__\":\n","\n","    df = run()\n","\n","    if not df.empty:\n","\n","        print(\"\\nTotal Artikel :\", len(df))\n","        print(\"Tanggal :\", df.date.min(), \"-\", df.date.max())\n","\n","        print(\"\\nTop 5 Artikel:\")\n","        print(\n","            df[[\"date\",\"title\"]]\n","            .head(5)\n","            .to_string(index=False)\n","        )"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"25990b3a","executionInfo":{"status":"ok","timestamp":1774520257971,"user_tz":-420,"elapsed":1196,"user":{"displayName":"Salwa Fitriyatunnisa","userId":"12126870913613015981"}},"outputId":"58c67cf5-0b8f-4da9-8579-935452c48640"},"source":["print(\"Mengambil dan mencetak struktur HTML dari halaman pencarian Kompas.com...\")\n","\n","# Mengambil keyword pertama untuk pengujian\n","keyword_to_test = KEYWORDS[0]\n","print(f\"Menguji keyword: '{keyword_to_test}'\")\n","\n","# Bangun URL pencarian untuk halaman pertama\n","url_to_test = build_search_url(keyword_to_test, 1)\n","print(f\"URL Halaman Pencarian: {url_to_test}\")\n","\n","soup = safe_get(url_to_test)\n","\n","if soup:\n","    print(\"\\n--- Sebagian Konten HTML dari Halaman Pencarian Kompas.com ---\")\n","    # Cetak keseluruhan body HTML atau sebagian besar untuk inspeksi\n","    body_html = soup.find(\"body\")\n","    if body_html:\n","        print(str(body_html)[:10000]) # Cetak 10000 karakter pertama dari body HTML\n","    else:\n","        print(\"Elemen <body> tidak ditemukan di halaman.\")\n","else:\n","    print(\"Gagal mengambil 