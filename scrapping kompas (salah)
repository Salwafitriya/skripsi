ate parse error: {text} - {e}\")\n","        return None\n","\n","def is_target_year(date):\n","    if not date:\n","        return False\n","    return date.startswith(str(TARGET_YEAR))\n","\n","# ================================================================\n","# AMBIL ISI ARTIKEL\n","# ================================================================\n","def get_article_content(soup):\n","    # Try multiple possible content selectors\n","    content_selectors = [\n","        \"div.read__content\",\n","        \"div.article-content\",\n","        \"div.content-detail\",\n","        \"article\"\n","    ]\n","\n","    content = None\n","    for selector in content_selectors:\n","        content = soup.select_one(selector)\n","        if content:\n","            break\n","\n","    if not content:\n","        return \"\"\n","\n","    paragraphs = content.find_all(\"p\")\n","    text = \" \".join(p.get_text(strip=True) for p in paragraphs if p.get_text(strip=True))\n","    return text\n","\n","# ================================================================\n","# PROCESS ARTICLE\n","# ================================================================\n","def process_article(title, link, keyword):\n","    time.sleep(random.uniform(SLEEP_MIN, SLEEP_MAX))\n","\n","    try:\n","        response = requests.get(link, headers=HEADERS, timeout=15)\n","        soup_detail = BeautifulSoup(response.text, \"html.parser\")\n","\n","        # Get date - try multiple selectors\n","        date = None\n","        date_selectors = [\n","            \"div.read__time\",\n","            \"div.article-date\",\n","            \"time\",\n","            \"div.date\"\n","        ]\n","\n","        for selector in date_selectors:\n","            date_tag = soup_detail.select_one(selector)\n","            if date_tag:\n","                date = parse_date(date_tag.get_text(strip=True))\n","                if date:\n","                    break\n","\n","        # Filter by year\n","        if n