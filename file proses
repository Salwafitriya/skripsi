,"    for file in file_list:\n","        try:\n","            df = pd.read_csv(file)\n","            df_list.append(df)\n","            total_before_merge += len(df)\n","\n","            print(f\"Loaded: {file} | {len(df)} rows\")\n","\n","        except Exception as e:\n","            print(f\"Error reading {file}: {e}\")\n","\n","    # Gabungkan\n","    combined_df = pd.concat(df_list, ignore_index=True)\n","\n","    before_drop = len(combined_df)\n","\n","    # Hapus duplikat\n","    if 'conversation_id_str' in combined_df.columns:\n","        combined_df = combined_df.drop_duplicates(subset=['conversation_id_str'])\n","    else:\n","        combined_df = combined_df.drop_duplicates()\n","\n","    after_drop = len(combined_df)\n","    duplicates_removed = before_drop - after_drop\n","\n","    percent_removed = (duplicates_removed / before_drop) * 100\n","\n","    # Simpan file\n","    output_name = f\"PDP_{key}_FINAL.csv\"\n","    combined_df.to_csv(output_name, index=False)\n","\n","    # Simpan statistik\n","    statistics.append({\n","        \"Dataset\": key,\n","        \"Total File Digabung\": len(file_list),\n","        \"Jumlah Awal\": before_drop,\n","        \"Jumlah Akhir\": after_drop,\n","        \"Duplikat Terhapus\": duplicates_removed,\n","        \"Persentase Duplikat (%)\": round(percent_removed, 2)\n","    })\n","\n","    # Print Statistik\n","    print(\"\\nStatistik:\")\n","    print(f\"Jumlah Awal       : {before_drop}\")\n","    print(f\"Jumlah Akhir      : {after_drop}\")\n","    print(f\"Duplikat Terhapus : {duplicates_removed}\")\n","    print(f\"Persentase        : {percent_removed:.2f}%\")\n","    print(f\"Saved: {output_name}\")\n","\n","# Simpan Statistik Global\n","stats_df = pd.DataFrame(statistics)\n","stats_df.to_csv(\"PDP_MERGE_STATISTICS.csv\", index=False)\n","\n","print(\"\\n==============================\")\n","print(\"STATISTIK KESELURUHAN\")\n","print(\"==============================\")\n","print(stats_df)"],"metadata":{"c