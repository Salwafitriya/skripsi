1)}_{tipe.group(1)}\"\n","\n","        if key not in groups:\n","            groups[key] = []\n","\n","        groups[key].append(file)\n","\n","# ============================================================\n","# Gabungkan File\n","# ============================================================\n","\n","stats = []\n","\n","for key, file_list in groups.items():\n","\n","    print(f\"\\nProcessing: {key}\")\n","\n","    dfs = []\n","    total_before = 0\n","\n","    for file in file_list:\n","        try:\n","            df = pd.read_csv(file)\n","            total_before += len(df)\n","            dfs.append(df)\n","\n","        except Exception as e:\n","            print(\"Error:\", file, e)\n","\n","    # Gabung\n","    merged = pd.concat(dfs, ignore_index=True)\n","\n","    # Hapus Duplikat\n","    before = len(merged)\n","\n","    # Jika ada kolom id gunakan ini (lebih aman)\n","    if 'id' in merged.columns:\n","        merged = merged.drop_duplicates(subset=['id'])\n","    elif 'text' in merged.columns:\n","        merged = merged.drop_duplicates(subset=['text'])\n","    else:\n","        merged = merged.drop_duplicates()\n","\n","    after = len(merged)\n","\n","    # Simpan\n","    output_file = os.path.join(\n","        OUTPUT_FOLDER,\n","        f\"PDP_{key}_merged.csv\"\n","    )\n","\n","    merged.to_csv(output_file, index=False)\n","\n","    print(\"Jumlah sebelum:\", before)\n","    print(\"Jumlah sesudah:\", after)\n","    print(\"Duplikat dihapus:\", before - after)\n","\n","    stats.append({\n","        \"File\": key,\n","        \"Jumlah Awal\": before,\n","        \"Jumlah Akhir\": after,\n","        \"Duplikat Dihapus\": before - after\n","    })\n","\n","# ============================================================\n","# Simpan Statistik\n","# ============================================================\n","\n","stats_df = pd.DataFrame(stats)\n","\n","stats_file = os.path.join(OUTPUT_FOLDER, \"statistik_penggabungan.csv\")\n","stats_df.to_csv